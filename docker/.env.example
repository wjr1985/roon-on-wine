# Copy to `.env` and adjust. Used by docker-compose.yml.
#
# NOTE: run.sh auto-detects HOST_UID/HOST_GID, RENDER_GID, VIDEO_GID, DISPLAY and
# the X cookie for you — the values below are only fallbacks for running
# `docker compose` directly. The one thing worth setting is MUSIC_DIR.

# --- Host user (so the mounted prefix/music are owned by you, not root) ---
HOST_UID=1000
HOST_GID=1000

# --- GPU device group IDs (host `getent group render video` — run.sh overrides these) ---
RENDER_GID=44
VIDEO_GID=39

# --- Display ---
DISPLAY=:0

# --- Local music library to expose to Roon as a watched folder (mounted at /music) ---
# Uncomment and point this at your local collection. Leave commented if you only
# stream / use network shares.
#MUSIC_DIR=/home/you/Music

# --- UI scale (1.0 default; 1.5–2.0 for HiDPI) ---
SCALEFACTOR=1.0

# --- Wine version pin (the primary knob) ---
# stable 10.0 avoids BOTH the Wine-11 WMI crash AND the washed-out-colours bug that
# affects winehq-staging. Alternative (newer, but colours wash out): staging 10.20.
WINE_BRANCH=stable
WINE_VERSION=10.0.0.0~bookworm-1

# --- .NET globalization ---
# Wine 10.x's icu.dll is incomplete and aborts Roon's bundled .NET; invariant mode
# skips ICU. Leave at 1 unless a future Wine implements the missing icu functions.
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

# --- DLL overrides when launching Roon ---
# Empty by default. Do NOT disable windows.media.mediacontrol on Wine 10.20 — it
# makes Roon's now-playing reset crash. Override only if a future Wine needs it.
WINEDLLOVERRIDES_RUN=
